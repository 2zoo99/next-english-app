// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// npx prisma generate 하기



generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int       @id @default(autoincrement())
  supabaseId  String    @unique
  name        String?
  email       String    @unique
  role        String    @default("USER")  // "USER" | "ADMIN"
  createdAt   DateTime  @default(now())
  sentences   Sentence[]
  expressions Expression[]
  studyLogs     StudyLog[]

  @@map("USER")
}

model Sentence {
  id            Int       @id @default(autoincrement())
  content       String    // @unique제거
  translate     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  userId        Int
  user          User      @relation(fields: [userId], references: [id])
  sentenceWords SentenceWord[]
  sentenceTags  SentenceTag[]
  expressionSentences ExpressionSentence[]
  
  @@unique([content, userId])   // 같은 사용자 안에서 중복 문장 금지
  @@map("SENTENCE")
}
//content는 원문

model Tag {
  id            Int       @id @default(autoincrement())
  name          String    @unique
  createdAt     DateTime  @default(now())
  sentenceTags  SentenceTag[]

  @@map("TAG")
}

model SentenceTag {
  id            Int       @id @default(autoincrement())
  sentence      Sentence  @relation(fields: [sentenceId], references: [id], onDelete: Cascade)
  sentenceId    Int       
  tag           Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId         Int

  @@unique([sentenceId, tagId])
  @@map("SENTENCE_TAG")
}

model Word {
  id            Int       @id @default(autoincrement())
  word          String    @unique //중복저장방지
  meaning       String?           //영영뜻
  createdAt     DateTime  @default(now())
  sentenceWords SentenceWord[]

  @@map("WORD")
}

model SentenceWord {
  id          Int       @id @default(autoincrement())
  order       Int
  sentence    Sentence  @relation(fields: [sentenceId], references: [id], onDelete: Cascade)
  sentenceId  Int
  word        Word      @relation(fields: [wordId], references: [id], onDelete: Cascade)
  wordId      Int
}

model Expression {
  id          Int       @id @default(autoincrement())
  content     String    // @unique제거
  meaning     String    
  createdAt   DateTime  @default(now())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  exampleLinks  ExpressionSentence[]

  @@unique([content, userId])   // 같은 사용자 안에서 같은 표현 중복 금지
  @@map("EXPRESSION")
}

model ExpressionSentence {
  id            Int         @id @default(autoincrement())
  expression    Expression  @relation(fields: [expressionId], references: [id], onDelete: Cascade)
  expressionId  Int
  sentence      Sentence    @relation(fields: [sentenceId], references: [id], onDelete: Cascade)
  sentenceId    Int
  startIndex    Int         //sentence.content에서 표현이 시작하는 글자 위치 
  endIndex      Int

  @@unique([expressionId, sentenceId])    // 같은 조합 중복 방지
  @@map("EXPRESSION_SENTENCE")
}

model StudyLog {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  date      DateTime  @db.Date   // 시각 없이 날짜만 저장
  count     Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, date])
  @@map("STUDY_LOG")
}

// @@map은 prisma 모델이름은 User이지만 실제 DB에 테이블 이름을 USER로 생성하는 것임. 
// schema 변경 시 반드시 마이그레이션 필요. 
// npx prisma migrate dev --name [변경기록이름] : schema.prisma를 읽어서 실제 db에 테이블 변경 적용, -> prisma client 코드 자동 재생성 = generate 기능
// npx prisma generate